{
  "version": "1.1.0-FROZEN",
  "description": "Neutral Evaluator Level 2 Fixed Task Checks Specification for SRDD Benchmark.",
  "is_example_specification": false,
  "schema": {
    "type": "object",
    "properties": {
      "task_id": { "type": "string" },
      "name": { "type": "string" },
      "command": { "type": "array", "items": { "type": "string" } },
      "test_script": { "type": "string" },
      "stdin_input": { "type": "string" },
      "expected_stdout_contains": { "type": "array", "items": { "type": "string" } },
      "expected_exit_code": { "type": "integer" }
    },
    "required": ["task_id", "expected_exit_code"]
  },
  "checks": [
    {
      "task_id": "srdd_educ_01",
      "name": "Science Question Solver Canonical Neutral Test Suite",
      "test_script": "eval/checks/test_srdd_educ_01.py",
      "expected_exit_code": 0,
      "notes": "Exercises Module Import, Object Instantiation, Multi-domain Science Problem Solving, and Clean Execution Lifecycle without GUI loop hang."
    },
    {
      "task_id": "example_cli_calc",
      "name": "CLI Calculator Basic Addition Test",
      "command": ["python", "calculator.py"],
      "stdin_input": "2 + 2\n",
      "expected_stdout_contains": ["4"],
      "expected_exit_code": 0,
      "notes": "Example CLI input test"
    },
    {
      "task_id": "example_text_converter",
      "name": "Markdown Parser Output Check",
      "command": ["python", "main.py", "--format", "html"],
      "stdin_input": "# Title\n",
      "expected_stdout_contains": ["<h1>Title</h1>"],
      "expected_exit_code": 0,
      "notes": "Example CLI argument conversion test"
    }
  ]
}
