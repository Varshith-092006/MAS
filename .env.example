# OpenRouter API credentials (never commit the actual .env file)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# OpenRouter Base URL (defaults to official OpenRouter endpoint)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter Model Selection:
# Available Free Models (at 0 cost):
#   - openrouter/free (Recommended smart auto-router for available free models)
#   - google/gemma-4-31b-it:free
#   - meta-llama/llama-3.3-70b-instruct:free
#   - qwen/qwen-2.5-coder-32b-instruct:free
# Paid Model Examples:
#   - openai/gpt-4o-mini
#   - openai/gpt-4o
OPENROUTER_MODEL=openrouter/free
OPENROUTER_CHEAP_MODEL=openrouter/free

# Database URL (defaults to local SQLite or PostgreSQL in Docker)
DATABASE_URL=sqlite:///./mas.db
# For Docker PostgreSQL:
# DATABASE_URL=postgresql://mas_user:mas_password@localhost:5432/mas_db

# Logging Proxy URL (optional, defaults to direct OpenRouter or local proxy)
# PROXY_BASE_URL=http://127.0.0.1:8089/v1

# Benchmark and Model Settings
SEED=42
TEMPERATURE=0

# Legacy compatibility (optional)
# OPENAI_API_KEY=
