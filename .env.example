# ===== Benchmark provider: Google Gemini API free tier (used for ALL benchmark runs) =====
# Never commit the real .env file. Copy this file to .env and fill in your own values.

# Key from Google AI Studio (aistudio.google.com/api-keys). Gemini keys start with "AIza".
PROVIDER_API_KEY=your_google_ai_studio_key_here

# Google's OpenAI-compatible endpoint (keep the trailing slash)
PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# One exact model ID, copied from the output of: python scripts/list_models.py
# Google IDs look like "gemini-3.5-flash-lite" (no "google/" prefix).
# Use the same model for MAS, ChatDev and every ablation. Never change it mid-benchmark.
BENCH_MODEL=

# Provider quota settings live in config.yaml (provider.*), not here.

# ===== Shared benchmark settings =====
SEED=42
TEMPERATURE=0

# ===== Database =====
DATABASE_URL=sqlite:///./mas.db
# For Docker PostgreSQL:
# DATABASE_URL=postgresql://mas_user:mas_password@localhost:5432/mas_db

# ===== Logging proxy (optional) =====
# PROXY_BASE_URL=http://127.0.0.1:8089/v1

# ===== Legacy OpenRouter settings: NOT used for the benchmark =====
# Kept only for old experiments. If any of these are set while PROVIDER_* are set,
# PROVIDER_* always wins and the preflight prints a warning.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=
# OPENROUTER_CHEAP_MODEL=
