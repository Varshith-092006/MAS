+def _is_trivial_placeholder_or_empty(code: str, fence_info: str = "") -> bool:
+    """Strictly checks whether code is empty, a prompt placeholder, JSON configuration alone, or a trivial no-op stub."""
+    stripped = code.strip()
+    if not stripped:
+        return True
+
+    # Non-code configuration blocks (json, yaml, xml, text) without python implementation
+    clean_fence = fence_info.strip().lower()
+    if clean_fence in ("json", "yaml", "yml", "toml", "xml", "text", "txt", "csv", "md", "markdown"):
+        return True
+
+    # Check for ChatDev's literal prompt placeholder template ('''\nDOCSTRING\n'''\nCODE)
+    stripped_no_docstring = re.sub(r"('''[\s\S]*?'''|\"\"\"[\s\S]*?\"\"\")", "", stripped).strip()
+    if stripped_no_docstring in ("", "CODE", "pass", "...", "None"):
+        return True
+
+    # If it is Python code, inspect the AST to ensure it contains substantive statements
+    try:
+        tree = ast.parse(stripped)
+        # Check if AST body has non-trivial implementation statements
+        # Reject if body consists solely of passes or bare literal expressions (constants, dicts, lists, sets, tuples)
+        substantive_nodes = [
+            node for node in tree.body
+            if not (
+                isinstance(node, ast.Pass)
+                or (isinstance(node, ast.Expr) and isinstance(getattr(node, "value", None), (ast.Constant, ast.Dict, ast.List, ast.Set, ast.Tuple)))
+            )
+        ]
+        if not substantive_nodes:
+            return True
+    except SyntaxError:
+        # If syntax error, verify whether it has at least code-like implementation keywords rather than pure prose or JSON
+        code_indicators = [r"\bdef\s+\w+", r"\bclass\s+\w+", r"\bimport\s+\w+", r"\bfrom\s+\w+", r"\bif\b", r"\bfor\b", r"\bwhile\b"]
+        has_code_indicator = any(re.search(pat, stripped) for pat in code_indicators)
+        if not has_code_indicator:
+            return True
+
+    return False
+
+
+def _extract_filename_from_fence(fence_info: str) -> str:
+    """Extract explicit filename from markdown fence info string if present.
+    e.g. ```python:main.py, ```python filename=main.py, ```main.py
+    """
+    if not fence_info:
+        return ""
+    m = re.search(r"([a-zA-Z0-9_\-]+\.(?:py|sh|txt|json|md|csv|html|css|js))\b", fence_info, re.IGNORECASE)
+    if m:
+        cand = m.group(1).lower()
+        if not re.match(r"^\d+\.\d+$", cand):
+            return cand
+    return ""
+
+
+def _extract_filename_from_comment(code: str) -> str:
+    """Extract filename from top comments within code block.
+    e.g. # main.py or # filename: main.py
+    """
+    for line in code.split("\n")[:5]:
+        line = line.strip()
+        m = re.match(r"^#\s*(?:(?:file|filename|filepath):\s*)?([a-zA-Z0-9_\-]+\.py)\b", line, re.IGNORECASE)
+        if m:
+            cand = m.group(1).lower()
+            if not re.match(r"^\d+\.\d+$", cand):
+                return cand
+    return ""
+
+
+def _extract_filename_from_preceding_text(preceding_text: str) -> str:
+    """Extract filename from preceding text lines right before the code block.
+    Supports markdown headings (### main.py), bold (**main.py**), or ChatDev single line format (main.py).
+    Ignores version numbers like '3.11'.
+    """
+    if not preceding_text:
+        return ""
+    lines = [l.strip() for l in preceding_text.split("\n") if l.strip()]
+    for line in reversed(lines[-4:]):
+        m = re.search(r"(?:###|##|#|\*\*|File:|Filename:)?\s*`?([a-zA-Z0-9_\-]+\.py)`?", line, re.IGNORECASE)
+        if m:
+            cand = m.group(1).lower()
+            if not re.match(r"^\d+\.\d+$", cand):
+                return cand
+        m_other = re.search(r"(?:###|##|#|\*\*|File:|Filename:)?\s*`?([a-zA-Z0-9_\-]+\.(?:txt|json|md|sh|csv|html|css|js))`?", line, re.IGNORECASE)
+        if m_other:
+            cand = m_other.group(1).lower()
+            if not re.match(r"^\d+\.\d+$", cand):
+                return cand
+    return ""
+
+
+def _extract_filename_from_code_structure(code: str, existing_filenames: set, fence_info: str = "") -> str:
+    """Fallback filename inference from code structure (class name, entrypoint, or default main.py)."""
+    clean_fence = fence_info.strip().lower()
+    if clean_fence in ("json", "yaml", "yml", "toml", "xml", "text", "txt", "csv", "md", "markdown"):
+        return ""
+
+    if ("__main__" in code or "def main(" in code) and "main.py" not in existing_filenames:
+        return "main.py"
+
+    m = re.search(r"class\s+([A-Za-z0-9_]+)", code)
+    if m:
+        cand = m.group(1).lower() + ".py"
+        if cand not in existing_filenames:
+            return cand
+
+    if "main.py" not in existing_filenames:
+        return "main.py"
+
+    return ""
+
 
