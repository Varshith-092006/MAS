# OpenAI API credentials (never commit the actual .env file)
OPENAI_API_KEY=your_openai_api_key_here

# Database URL (defaults to local SQLite or PostgreSQL in Docker)
DATABASE_URL=sqlite:///./mas.db
# For Docker PostgreSQL:
# DATABASE_URL=postgresql://mas_user:mas_password@localhost:5432/mas_db

# Logging Proxy URL
PROXY_BASE_URL=http://127.0.0.1:8089/v1

# Benchmark and Model Settings
SEED=42
DEFAULT_MODEL=gpt-4o
CHEAP_MODEL=gpt-4o-mini
TEMPERATURE=0
