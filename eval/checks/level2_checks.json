{
  "version": "1.0",
  "description": "Neutral Evaluator Level 2 Fixed Task Checks Specification (Example template). Real task checks to be provided by benchmark owners.",
  "is_example_specification": true,
  "schema": {
    "type": "object",
    "properties": {
      "task_id": { "type": "string" },
      "command": { "type": "array", "items": { "type": "string" } },
      "stdin_input": { "type": "string" },
      "expected_stdout_contains": { "type": "array", "items": { "type": "string" } },
      "expected_exit_code": { "type": "integer" }
    },
    "required": ["task_id", "command", "expected_exit_code"]
  },
  "checks": [
    {
      "task_id": "example_cli_calc",
      "name": "CLI Calculator Basic Addition Test",
      "command": ["python", "calculator.py"],
      "stdin_input": "2 + 2\n",
      "expected_stdout_contains": ["4"],
      "expected_exit_code": 0,
      "notes": "Example CLI input test"
    },
    {
      "task_id": "example_text_converter",
      "name": "Markdown Parser Output Check",
      "command": ["python", "main.py", "--format", "html"],
      "stdin_input": "# Title\n",
      "expected_stdout_contains": ["<h1>Title</h1>"],
      "expected_exit_code": 0,
      "notes": "Example CLI argument conversion test"
    },
    {
      "task_id": "example_api_health",
      "name": "API Service Smoke Check",
      "command": ["python", "-c", "import main; print(hasattr(main, 'app') or hasattr(main, 'run'))"],
      "stdin_input": "",
      "expected_stdout_contains": ["True"],
      "expected_exit_code": 0,
      "notes": "Example module export smoke test"
    }
  ]
}
